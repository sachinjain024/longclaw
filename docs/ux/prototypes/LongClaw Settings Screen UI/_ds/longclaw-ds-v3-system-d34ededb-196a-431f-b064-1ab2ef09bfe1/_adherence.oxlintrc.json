{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/avatars/**",
              "components/cards/**",
              "components/chips/**",
              "components/feedback/**",
              "components/forms/**",
              "components/indicators/**",
              "components/timeline/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Familjen Grotesk|Geist|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Familjen Grotesk, Geist, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:initials|hue|agent|size|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: initials, hue, agent, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|actions|style|key|ref|className|style|children)$/]",
        "message": "<Banner> doesn't accept that prop. Declared props: children, actions, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BoardCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|status|priority|label|assignee|progress|agentFresh|agentNote|style|key|ref|className|style|children)$/]",
        "message": "<BoardCard> doesn't accept that prop. Declared props: id, title, status, priority, label, assignee, progress, agentFresh, agentNote, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BoardCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:backlog|todo|in-progress|in-review|done|canceled)$/]",
        "message": "<BoardCard> status must be one of 'backlog' | 'todo' | 'in-progress' | 'in-review' | 'done' | 'canceled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BoardCard'] > JSXAttribute[name.name='priority'] > Literal[value!=/^(?:urgent|high|medium|low|none)$/]",
        "message": "<BoardCard> priority must be one of 'urgent' | 'high' | 'medium' | 'low' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|hint|disabled|children|style|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, hint, disabled, children, style, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|small)$/]",
        "message": "<Button> size must be one of 'default' | 'small'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checklist'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|style|key|ref|className|style|children)$/]",
        "message": "<Checklist> doesn't accept that prop. Declared props: items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|dot|children|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: variant, dot, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:label|agent|id)$/]",
        "message": "<Chip> variant must be one of 'label' | 'agent' | 'id'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|placeholder|value|defaultValue|onChange|style|inputStyle|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: variant, placeholder, value, defaultValue, onChange, style, inputStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|path)$/]",
        "message": "<Input> variant must be one of 'default' | 'path'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriorityIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:priority|size|key|ref|className|style|children)$/]",
        "message": "<PriorityIcon> doesn't accept that prop. Declared props: priority, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriorityIcon'] > JSXAttribute[name.name='priority'] > Literal[value!=/^(?:urgent|high|medium|low|none)$/]",
        "message": "<PriorityIcon> priority must be one of 'urgent' | 'high' | 'medium' | 'low' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|size|key|ref|className|style|children)$/]",
        "message": "<StatusIcon> doesn't accept that prop. Declared props: status, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusIcon'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:backlog|todo|in-progress|in-review|done|canceled)$/]",
        "message": "<StatusIcon> status must be one of 'backlog' | 'todo' | 'in-progress' | 'in-review' | 'done' | 'canceled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimelineEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|author|time|via|children|style|key|ref|className|style|children)$/]",
        "message": "<TimelineEntry> doesn't accept that prop. Declared props: variant, author, time, via, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimelineEntry'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:human|agent|event)$/]",
        "message": "<TimelineEntry> variant must be one of 'human' | 'agent' | 'event'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|kbd|action|style|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: children, kbd, action, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
