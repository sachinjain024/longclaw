{
  "$schema": "./design-tokens.schema.json",
  "name": "LongClaw visual foundations",
  "version": "1.0.0",
  "description": "Canonical Phase 0 design-token source. Components consume the generated --lc-* custom properties and never literal accent hues.",
  "system": {
    "font-family-display": "\"Familjen Grotesk\", \"Avenir Next\", sans-serif",
    "font-family-ui": "\"Geist\", \"SF Pro Text\", -apple-system, BlinkMacSystemFont, sans-serif",
    "font-family-mono": "\"JetBrains Mono\", \"SFMono-Regular\", Consolas, monospace",
    "font-size-display": "26px",
    "font-size-title": "17px",
