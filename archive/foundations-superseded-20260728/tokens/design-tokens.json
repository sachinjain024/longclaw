    "font-size-small": "12.5px",
    "font-size-label": "11px",
    "font-size-code": "12px",
    "line-height-display": "32px",
    "line-height-title": "22px",
    "line-height-body": "20px",
    "line-height-ui": "18px",
    "line-height-small": "18px",
    "line-height-label": "16px",
    "line-height-code": "18px",
    "font-weight-regular": "400",
    "font-weight-medium": "500",
    "font-weight-semibold": "600",
    "font-weight-bold": "700",
    "letter-spacing-display": "-0.018em",
    "letter-spacing-title": "-0.01em",
    "letter-spacing-label": "0.015em",
    "letter-spacing-mono": "-0.01em",
    "space-0": "0",
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-5": "20px",
    "space-6": "24px",
    "space-8": "32px",
    "space-10": "40px",
    "control-height-small": "26px",
    "control-height": "30px",
    "list-row-height": "36px",
    "radius-control": "5px",
    "radius-card": "8px",
    "radius-panel": "10px",
    "radius-modal": "14px",
    "radius-round": "999px",
    "border-width": "1px",
    "border-width-focus": "2px",
    "elevation-none": "none",
    "elevation-card": "0 1px 2px var(--lc-shadow-color)",
    "elevation-popover": "0 8px 24px var(--lc-shadow-color), 0 2px 6px var(--lc-shadow-color-tight)",
    "elevation-panel": "0 16px 48px var(--lc-shadow-color), 0 4px 12px var(--lc-shadow-color-tight)",
    "focus-ring": "0 0 0 1px var(--lc-color-surface), 0 0 0 3px var(--lc-accent-human)",
    "motion-duration-hover": "80ms",
    "motion-duration-state": "120ms",
    "motion-duration-panel": "150ms",
    "motion-duration-agent-pulse": "900ms",
    "motion-agent-pulse-iterations": "2",
    "motion-ease-standard": "cubic-bezier(0.2, 0, 0, 1)",
    "motion-ease-exit": "cubic-bezier(0.4, 0, 1, 1)",
    "opacity-disabled": "0.48",
    "icon-size-xs": "12px",
    "icon-size-small": "14px",
    "icon-size": "16px",
    "icon-size-large": "20px",
    "icon-size-brand": "24px",
    "icon-stroke": "1.5",
    "icon-stroke-emphasis": "1.75",
    "icon-grid": "16",
    "z-base": "0",
    "z-sticky": "10",
    "z-panel": "30",
    "z-modal": "50",
    "z-toast": "70"
