{
  "$meta": {
    "name": "LongClaw design tokens",
    "version": "1.0.0",
    "source": "docs/design/fable-design-system-v1.mhtml (approved reference) + docs/design_brief.md (final iteration)",
    "prefix": "--lc-",
    "axes": {
      "appearance": ["light", "dark"],
      "theme": ["indigo", "clay", "slate", "plum"]
    },
    "contract": "Both axes are independent. Apply data-appearance and data-theme on the same root element (<html>). Components consume only --lc-* tokens; no component may hardcode an accent hue. Switching theme or appearance is a token swap and nothing else.",
    "notes": "Color values that differ from the approved visual reference were adjusted to clear WCAG AA; every adjustment is recorded in ../decisions.md and verified by ../scripts/a11y-check.mjs."
  },

  "font": {
    "display": "\"Familjen Grotesk\", \"Familjen Grotesk Fallback\", -apple-system, \"Segoe UI\", sans-serif",
    "ui": "Geist, \"Geist Fallback\", -apple-system, \"Segoe UI\", system-ui, sans-serif",
    "mono": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, monospace"
  },

  "type": {
    "display": {
      "font": "display",
      "size": 26,
      "weight": 600,
      "lineHeight": 1.2,
      "tracking": "-0.015em"
    },
    "title": {
      "font": "ui",
      "size": 17,
      "weight": 600,
      "lineHeight": 1.35,
      "tracking": "-0.01em"
    },
    "heading": {
      "font": "ui",
      "size": 14.5,
      "weight": 600,
      "lineHeight": 1.4,
      "tracking": "0"
    },
    "body": {
      "font": "ui",
      "size": 13.5,
      "weight": 400,
      "lineHeight": 1.5,
      "tracking": "0"
    },
    "ui": {
      "font": "ui",
      "size": 13,
      "weight": 500,
      "lineHeight": 1.4,
      "tracking": "0"
    },
    "small": {
      "font": "ui",
      "size": 12.5,
      "weight": 400,
      "lineHeight": 1.45,
      "tracking": "0"
    },
    "micro": {
      "font": "ui",
      "size": 11.5,
      "weight": 500,
      "lineHeight": 1.35,
      "tracking": "0"
    },
    "label": {
      "font": "mono",
      "size": 11,
      "weight": 500,
      "lineHeight": 1.3,
      "tracking": "0.06em",
      "transform": "uppercase"
    },
    "code": {
      "font": "mono",
      "size": 12,
      "weight": 400,
      "lineHeight": 1.5,
      "tracking": "0"
    },
    "kbd": {
      "font": "mono",
      "size": 10,
      "weight": 500,
      "lineHeight": 1.2,
      "tracking": "0.02em"
    }
  },

  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "7": 32,
    "8": 40
  },

  "size": {
    "row": 36,
    "control": 30,
    "control-sm": 24,
    "chip": 22,
    "chip-sm": 19,
    "avatar": 26,
    "avatar-sm": 20,
    "checkbox": 15,
    "glyph": 14,
    "glyph-sm": 13,
    "theme-dot": 6,
    "card-width-min": 240,
    "card-pad-x": 12,
    "card-pad-y": 10,
    "panel-gutter": 16,
    "panel-gutter-lg": 24
  },

  "radius": {
    "kbd": 3,
    "tile": 4,
    "control": 5,
    "card": 8,
    "panel": 10,
    "modal": 14,
    "full": 999
  },

  "border": { "hairline": 1, "ring": 1.5, "rail": 2, "focus": 3 },

  "motion": {
    "fast": "80ms",
    "state": "120ms",
    "panel": "150ms",
    "ease": "cubic-bezier(0.2, 0, 0, 1)",
    "pulse-duration": "900ms",
    "pulse-iterations": 2,
    "note": "Motion communicates state, never decorates. The agent pulse (900ms ease-out, two beats) is the one exception to the sub-150ms rule: it is the designed acknowledgement of an external file edit."
  },

  "elevation": {
    "light": {
      "card": "0 1px 2px rgba(23, 25, 35, 0.04)",
      "overlay": "0 6px 18px rgba(23, 25, 35, 0.22)",
      "modal": "0 16px 48px rgba(23, 25, 35, 0.28)"
    },
    "dark": {
      "card": "none",
      "overlay": "0 6px 18px rgba(0, 0, 0, 0.40)",
      "modal": "0 16px 48px rgba(0, 0, 0, 0.55)"
    },
    "note": "Dark surfaces carry elevation with the raised color and hairlines, not shadow. Cards in dark have no shadow."
  },

  "mix": {
    "note": "Percentages for color-mix(in oklab, accent N%, base) derivations, per appearance. These make every soft/tint variant a pure derivation of the two accent tokens, so a theme preset only supplies accents.",
    "light": {
      "soft": "10%",
      "wash": "7%",
      "ring": "14%",
      "fresh-ring": "10%",
      "border": "38%",
      "rail": "35%",
      "avatar-ring": "65%",
      "pulse": "38%",
      "hover": "90%",
      "active": "82%"
    },
    "dark": {
      "soft": "15%",
      "wash": "10%",
      "ring": "18%",
      "fresh-ring": "13%",
      "border": "42%",
      "rail": "40%",
      "avatar-ring": "70%",
      "pulse": "38%",
      "hover": "90%",
      "active": "82%"
    }
  },

  "color": {
    "neutral": {
      "bg": { "light": "#F4F5F8", "dark": "#0F1015", "role": "app canvas" },
      "surface": {
        "light": "#FFFFFF",
        "dark": "#16171E",
        "role": "cards, panels"
      },
      "raised": {
        "light": "#FFFFFF",
        "dark": "#1C1E27",
        "role": "hover surfaces, popovers; light pairs with elevation.overlay"
      },
      "wash": {
        "light": "#EEF0F5",
        "dark": "#1C1E27",
        "role": "inline code chips, quiet fills, progress track"
      },
      "ink": {
        "light": "#171923",
        "dark": "#E9EAF2",
        "role": "titles, primary text"
      },
      "ink-2": {
        "light": "#4C5165",
        "dark": "#A6AABC",
        "role": "body, secondary text"
      },
      "ink-3": {
        "light": "#666B80",
        "dark": "#8A8FA3",
        "role": "meta, timestamps, placeholders — AA-adjusted from reference #878CA0/#676C80"
      },
      "ink-disabled": {
        "light": "#A9ADC0",
        "dark": "#565B6E",
        "role": "disabled text/glyphs only (WCAG-exempt)"
      },
      "line": {
        "light": "#E3E5EE",
        "dark": "#262935",
        "role": "borders, dividers"
      },
      "line-soft": {
        "light": "#EEF0F5",
        "dark": "#232633",
        "role": "in-card dividers"
      },
      "line-strong": {
        "light": "#DCDFE9",
        "dark": "#2C2F3C",
        "role": "control borders"
      },
      "scrim": {
        "light": "rgba(23, 25, 35, 0.40)",
        "dark": "rgba(0, 0, 0, 0.55)",
        "role": "modal backdrop"
      },
      "tile": {
        "light": "#171923",
        "dark": "#060709",
        "role": "agent avatar tile — a terminal window in miniature; always near-black in both appearances"
      },
      "inverse-surface": {
        "light": "#171923",
        "dark": "#E9EAF2",
        "role": "toast background"
      },
      "inverse-ink": {
        "light": "#FFFFFF",
        "dark": "#171923",
        "role": "toast text"
      },
      "inverse-ink-2": {
        "light": "#A6AABC",
        "dark": "#5A5F75",
        "role": "toast secondary text"
      }
    },

    "status": {
      "note": "Status = color dot + text label (founder revision 2026-07-28, decisions.md D3 — retires the reference's pie/check/X glyphs). One dot geometry: the default state is an unfilled ring (today's Todo); every other state is the same dot filled with the status color. Statuses are user-definable: a new status always gets a color, defaulting to the grey ring; user choices come from the label ramp. The dot never appears without its label except on the board, where the column header names it. Done still routes to the human accent (D5) and green is never offered. Theme-independent except done. AA: built-in dot colors ≥ 3:1 against surface and bg; user-ramp dots lean on the mandatory label, like label chips.",
      "backlog": {
        "light": "#82879B",
        "dark": "#767B90",
        "glyph": "dashed ring — before the default state; the dash survives every CVD type"
      },
      "todo": {
        "light": "#82879B",
        "dark": "#8A8FA3",
        "glyph": "open ring — THE default state and the default for new statuses"
      },
      "in-progress": {
        "light": "#B47D0A",
        "dark": "#E7B23A",
        "glyph": "filled dot — AA-adjusted from reference #DE9B0D in light"
      },
      "in-review": {
        "light": "#C25C1B",
        "dark": "#EC8B4C",
        "glyph": "filled dot — AA-adjusted from reference #E5732A in light"
      },
      "done": {
        "light": "accent.human",
        "dark": "accent.human",
        "glyph": "filled dot in the human accent"
      },
      "canceled": {
        "light": "#82879B",
        "dark": "#767B90",
        "glyph": "filled dot, grey"
      }
    },

    "priority": {
      "note": "Six levels: Urgent · P1 · P2 · P3 · P4 · None (founder revision 2026-07-28, decisions.md D4 — replaces the reference's High/Medium/Low bar glyphs). P1–P4 are bordered mono chips, monochrome except urgent; the number carries the level. Chip text is real text, held to 4.5:1; the border is a decorative container.",
      "urgent": {
        "light": "#C2591D",
        "dark": "#E0762F",
        "mark-light": "#FFFFFF",
        "mark-dark": "#101116"
      },
      "chip-text": { "light": "#5A5F75", "dark": "#9DA2B5" },
      "chip-border": { "light": "#B9BDCC", "dark": "#3F4354" },
      "none": { "light": "#8A8FA3", "dark": "#767B90" }
    },

    "feedback": {
      "warn": {
        "light": "#9A5008",
        "dark": "#D98E3E",
        "role": "conflicts, unreachable folder — AA-adjusted from reference #B45309 in light"
      },
      "warn-surface": { "light": "#FBF3E8", "dark": "#2A2119" },
      "warn-border": { "light": "#EBD5B5", "dark": "#4A3A24" },
      "warn-border-strong": { "light": "#E0C9A6", "dark": "#4A3A24" },
      "warn-ink": {
        "light": "#7D5F33",
        "dark": "#C89A62",
        "role": "secondary action text inside warn banners"
      },
      "danger": {
        "light": "#C43A3A",
        "dark": "#E06C6C",
        "role": "destructive actions, parse errors — AA-adjusted from reference #D64545 in light"
      },
      "danger-surface": { "light": "#FBEFEF", "dark": "#2A1B1D" },
      "danger-border": { "light": "#EFD3D3", "dark": "#4A2A2E" }
    },

    "label": {
      "note": "Fixed system ramp for project labels; never themed. Dots are reinforcement only — the chip text is the identifier — so dots are not held to 3:1. The green band (hue 120–165) is excluded: green belongs to the agent, exclusively.",
      "blue": { "light": "#4E9CF5", "dark": "#5FA8F7" },
      "cyan": { "light": "#2E9BB8", "dark": "#4FB3CE" },
      "purple": { "light": "#9A6BF3", "dark": "#A981F5" },
      "pink": { "light": "#C94C86", "dark": "#D66A9C" },
      "red": { "light": "#E15B5B", "dark": "#E57373" },
      "orange": { "light": "#E1703C", "dark": "#E5854F" },
      "amber": { "light": "#D9A514", "dark": "#E0B13A" },
      "gray": { "light": "#8A90A5", "dark": "#9DA2B5" }
    }
  },

  "themes": {
    "note": "A theme preset supplies exactly four accent decisions per appearance: the accent (fills, rings, borders), the text variant (AA ≥ 4.5:1 as small text on surface and soft chips), the on-accent color (button labels, glyph marks on accent fills), and nothing else. Every soft/hover/ring/rail variant derives from these via mix.*. The agent pair is identical in every preset — agent activity must read the same in every project.",
    "indigo": {
      "label": "Indigo",
      "default": true,
      "human": { "light": "#6B5CF6", "dark": "#887DF2" },
      "human-text": { "light": "#5D4DE8", "dark": "#9C93F4" },
      "on-human": { "light": "#FFFFFF", "dark": "#101116" },
      "agent": { "light": "#279E52", "dark": "#6CD592" },
      "agent-text": { "light": "#1B7A3D", "dark": "#7FDCA0" },
      "on-agent": { "light": "#FFFFFF", "dark": "#0F1015" }
    },
    "clay": {
      "label": "Clay",
      "human": { "light": "#9C4126", "dark": "#C57A55" },
      "human-text": { "light": "#9C4126", "dark": "#C97F5B" },
      "on-human": { "light": "#FFFFFF", "dark": "#101116" },
      "agent": { "light": "#279E52", "dark": "#6CD592" },
      "agent-text": { "light": "#1B7A3D", "dark": "#7FDCA0" },
      "on-agent": { "light": "#FFFFFF", "dark": "#0F1015" }
    },
    "slate": {
      "label": "Slate",
      "proposed": true,
      "human": { "light": "#3D6BC4", "dark": "#85A7EC" },
      "human-text": { "light": "#3765BD", "dark": "#93B0EE" },
      "on-human": { "light": "#FFFFFF", "dark": "#101116" },
      "agent": { "light": "#279E52", "dark": "#6CD592" },
      "agent-text": { "light": "#1B7A3D", "dark": "#7FDCA0" },
      "on-agent": { "light": "#FFFFFF", "dark": "#0F1015" }
    },
    "plum": {
      "label": "Plum",
      "proposed": true,
      "human": { "light": "#A23F9C", "dark": "#D48BD0" },
      "human-text": { "light": "#9C3B96", "dark": "#D897D5" },
      "on-human": { "light": "#FFFFFF", "dark": "#101116" },
      "agent": { "light": "#279E52", "dark": "#6CD592" },
      "agent-text": { "light": "#1B7A3D", "dark": "#7FDCA0" },
      "on-agent": { "light": "#FFFFFF", "dark": "#0F1015" }
    }
  }
}
