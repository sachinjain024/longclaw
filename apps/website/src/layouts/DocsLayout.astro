---
import type { MarkdownHeading } from 'astro';
import PageNav from '../components/PageNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { DOCS_NAV, SITE, absolute } from '../lib/site';
import BaseLayout from './BaseLayout.astro';

/**
 * The documentation shell: sidebar nav, a readable measure, and an
 * on-this-page rail on wide screens.
 */
interface Props {
  title: string;
  description: string;
  eyebrow: string;
  path: string;
  headings: MarkdownHeading[];
}

const { title, description, eyebrow, path, headings } = Astro.props;

/* Only h2 and h3 belong in the rail — deeper than that and it stops being a
   map and starts being a duplicate of the page. */
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

const current = DOCS_NAV.find((entry) => entry.href === path);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: title,
    description,
    url: absolute(path),
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: absolute('/') },
    author: { '@type': 'Person', name: SITE.author },
    about: { '@type': 'SoftwareApplication', name: SITE.name },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absolute('/') },
      { '@type': 'ListItem', position: 2, name: 'Docs', item: absolute('/docs') },
      ...(path === '/docs'
        ? []
        : [{ '@type': 'ListItem', position: 3, name: current?.label ?? title, item: absolute(path) }]),
    ],
  },
];
---

<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd}>
  <SiteHeader variant="docs" path={path} />

  <div class="docs">
    <aside class="docs__sidebar">
      <div class="docs__rail-label">Guide</div>
      <nav aria-label="Documentation">
        {
          DOCS_NAV.map((entry) => (
            <a href={entry.href} aria-current={entry.href === path ? 'page' : undefined}>
              {entry.label}
            </a>
          ))
        }
      </nav>
    </aside>

    <main class="docs__main" id="main">
      <div class="eyebrow">{eyebrow}</div>
      <h1 class="h-page">{title}</h1>
      <p class="lead" style="margin-bottom:36px;">{description}</p>

      <div class="doc-body">
        <slot />
      </div>

      <PageNav path={path} />
    </main>

    {
      toc.length > 1 && (
        <aside class="docs__toc" aria-label="On this page">
          <div class="docs__rail-label">On this page</div>
          <nav>
            {toc.map((heading) => (
              <a href={`#${heading.slug}`} data-depth={heading.depth} data-toc-link>
                {heading.text}
              </a>
            ))}
          </nav>
        </aside>
      )
    }
  </div>

  <SiteFooter variant="docs" />
</BaseLayout>

<script>
  /* Highlight the section currently in view. Progressive enhancement: without
     it the rail is still a working list of links. */
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
  if (links.length > 0 && 'IntersectionObserver' in window) {
    const byId = new Map(links.map((link) => [decodeURIComponent(link.hash.slice(1)), link]));
    const targets = Array.from(byId.keys())
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    const visible = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        }
        // The topmost visible heading owns the highlight.
        const active = targets.find((target) => visible.has(target.id))?.id;
        links.forEach((link) =>
          link.classList.toggle('is-active', decodeURIComponent(link.hash.slice(1)) === active)
        );
      },
      { rootMargin: '-84px 0px -70% 0px' }
    );
    targets.forEach((target) => observer.observe(target));
  }
</script>
