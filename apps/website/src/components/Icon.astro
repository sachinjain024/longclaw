---
/**
 * The site's whole icon set, in one file.
 *
 * The design system substitutes Lucide for the icons the brand does not own,
 * at 1.5–2px stroke. Rather than pull the library in, the handful actually
 * used are inlined here — same geometry, no dependency, no network request.
 * The GitHub and Apple glyphs are those companies' own marks and are solid
 * fills rather than strokes.
 */
export type IconName =
  | 'github'
  | 'apple'
  | 'sun'
  | 'moon'
  | 'wifi-off'
  | 'zap'
  | 'activity-off'
  | 'code'
  | 'rss'
  | 'arrow-right';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 16, class: className } = Astro.props;

const solid = name === 'github' || name === 'apple';
const viewBox = name === 'github' ? '0 0 16 16' : name === 'apple' ? '0 0 384 512' : '0 0 24 24';
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox={viewBox}
  fill={solid ? 'currentColor' : 'none'}
  stroke={solid ? undefined : 'currentColor'}
  stroke-width={solid ? undefined : 2}
  stroke-linecap={solid ? undefined : 'round'}
  stroke-linejoin={solid ? undefined : 'round'}
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'github' && (
      <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
    )
  }
  {
    name === 'apple' && (
      <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.7-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z" />
    )
  }
  {
    name === 'sun' && (
      <>
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
      </>
    )
  }
  {name === 'moon' && <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />}
  {
    name === 'wifi-off' && (
      <>
        <path d="M12 20h.01" />
        <path d="M8.5 16.5a5 5 0 0 1 7 0" />
        <path d="M5 12.9a10 10 0 0 1 5.2-2.7" />
        <path d="M19 12.9a10 10 0 0 0-2.6-1.8" />
        <line x1="3" y1="3" x2="21" y2="21" />
      </>
    )
  }
  {name === 'zap' && <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />}
  {
    name === 'activity-off' && (
      <>
        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
        <line x1="3" y1="3" x2="21" y2="21" />
      </>
    )
  }
  {
    name === 'code' && (
      <>
        <polyline points="16 18 22 12 16 6" />
        <polyline points="8 6 2 12 8 18" />
      </>
    )
  }
  {
    name === 'rss' && (
      <>
        <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" />
        <circle cx="5" cy="19" r="1" />
      </>
    )
  }
  {
    name === 'arrow-right' && (
      <>
        <line x1="5" y1="12" x2="19" y2="12" />
        <polyline points="12 5 19 12 12 19" />
      </>
    )
  }
</svg>
