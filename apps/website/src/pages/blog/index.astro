---
import { getCollection } from 'astro:content';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, absolute } from '../../lib/site';
import { formatDate } from '../../lib/format';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const description = 'What changed in LongClaw, and why it works the way it does.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: `${SITE.name} blog`,
    description,
    url: absolute('/blog'),
    blogPost: posts.map((post) => ({
      '@type': 'BlogPosting',
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.date.toISOString(),
      author: { '@type': 'Person', name: post.data.author },
      url: absolute(`/blog/${post.id}`),
    })),
  },
];
---

<BaseLayout title="Blog" description={description} path="/blog" jsonLd={jsonLd}>
  <SiteHeader path="/blog" />

  <main class="text-page" id="main">
    <div class="eyebrow">Blog</div>
    <h1 class="h-page">Notes from the workshop</h1>
    <p class="lead" style="margin-bottom:48px;">{description}</p>

    <div class="post-list">
      {
        posts.map((post) => (
          <a class="post-list__item" href={`/blog/${post.id}`}>
            <time class="post-list__date" datetime={post.data.date.toISOString().slice(0, 10)}>
              {formatDate(post.data.date)}
            </time>
            <span class="post-list__body">
              <span class="post-list__title">{post.data.title}</span>
              <span class="post-list__summary">{post.data.description}</span>
            </span>
          </a>
        ))
      }
    </div>

    <p class="fineprint" style="margin-top:32px;">
      <a href="/blog/rss.xml">RSS feed</a>
    </p>
  </main>

  <SiteFooter />
</BaseLayout>
