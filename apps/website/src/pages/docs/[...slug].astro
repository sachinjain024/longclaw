---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';

/**
 * Every docs page. `index` becomes /docs; everything else keeps its filename.
 */
export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => ({
    params: { slug: entry.id === 'index' ? undefined : entry.id },
    props: { entry },
  }));
}

type Props = { entry: CollectionEntry<'docs'> };

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const path = entry.id === 'index' ? '/docs' : `/docs/${entry.id}`;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  eyebrow={entry.data.eyebrow}
  path={path}
  headings={headings}
>
  <Content />
</DocsLayout>
